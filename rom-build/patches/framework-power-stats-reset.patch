+                mAggregatedStatsCount++;
+                long[] values = new long[1];
+                PowerComponentAggregatedPowerStats component =
+                        stats.getPowerComponentStats(TEST_POWER_COMPONENT);
+                assertThat(component.getDeviceStats(values, new int[]{
+                        AggregatedPowerStatsConfig.POWER_STATE_OTHER,
+                        AggregatedPowerStatsConfig.SCREEN_STATE_ON})).isTrue();
+                assertThat(values).isEqualTo(new long[]{10000});
+            });
+            assertThat(mAggregatedStatsCount).isEqualTo(1);
+            mAggregator.reset();
+        }
+    }
