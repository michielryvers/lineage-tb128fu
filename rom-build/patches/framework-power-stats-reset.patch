+        powerStats.stats = new long[]{0};
+        mHistory.recordPowerStats(mClock.realtime, mClock.uptime, powerStats);
+        advance(1000);
+        powerStats.stats = new long[]{10000};
+        mHistory.recordPowerStats(mClock.realtime, mClock.uptime, powerStats);
+
+        // Exporter resets the aggregator after each query. Repeating an unchanged
