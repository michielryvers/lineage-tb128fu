diff --git a/drivers/video/backlight/sgm37604a_driver.c b/drivers/video/backlight/sgm37604a_driver.c
index f88a46404..4f5bbd37e 100755
--- a/drivers/video/backlight/sgm37604a_driver.c
+++ b/drivers/video/backlight/sgm37604a_driver.c
@@ -152,6 +152,19 @@ void SGM37604A_set_backlight_reg_init(void)
 	data2 = backlight_current_reg;
 
 	gpio_set_value(pchip->en_gpio,1);
+	/*
+	 * tb128fu: put the SGM37604A into I2C x PWM mode (0x11 = 0x55) and keep
+	 * the remaining bootloader configuration. Brightness is set through the
+	 * I2C current registers while the panel PWM input stays at 100% duty.
+	 * PWM-only dimming (0x35) and I2C-only mode (0x00/0x15) both show visible
+	 * flicker at high brightness on dark content.
+	 */
+	{
+		unsigned char mode = 0x55;
+
+		SGM37604A_smbus_write_byte(pchip->client, SGM37604A_CTL_BACKLIGHT_MODE_REG, &mode);
+	}
+	return;
 
 	ret_code = SGM37604A_smbus_write_byte(pchip->client, SGM37604A_CTL_BACKLIGHT_MODE_REG, &data0);
 	if (ret_code != 0) {
